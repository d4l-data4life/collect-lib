      "expected": "2026-06-10T08:00:00.000Z"
    },
    {
      "name": "multi-select answer lacks code",
      "condition": {
        "type": "question",
        "questionType": "coding",
        "surveyName": "survey1",
        "linkID": "M1",
        "operator": "!=",
        "operand": "a"
      },
      "expected": null
