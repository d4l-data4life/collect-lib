      "condition": {
        "type": "question",
        "questionType": "coding",
        "surveyName": "survey1",
        "linkID": "A1",
        "operator": "=",
        "operand": "yes"
      },
      "expected": "2026-06-10T08:00:00.000Z"
    },
    {
      "name": "coding answer matches, with offset",
      "condition": {
        "type": "question",
        "questionType": "coding",
        "surveyName": "survey1",
        "linkID": "A1",
        "operator": "=",
        "operand": "yes",
        "offset": "P2D"
      },
      "expected": "2026-06-12T08:00:00.000Z"
    },
    {
      "name": "coding answer matches, with negative offset",
      "condition": {
        "type": "question",
        "questionType": "coding",
        "surveyName": "survey1",
        "linkID": "A1",
        "operator": "=",
        "operand": "yes",
        "offset": "-PT12H"
      },
      "expected": "2026-06-09T20:00:00.000Z"
    },
    {
      "name": "coding answer does not match",
      "condition": {
        "type": "question",
        "questionType": "coding",
        "surveyName": "survey2",
        "linkID": "A1",
        "operator": "=",
        "operand": "yes"
      },
      "expected": null
