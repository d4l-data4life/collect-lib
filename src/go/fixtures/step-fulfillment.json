    {
      "name": "offset around nested and",
      "condition": {
        "type": "offset",
        "offset": "P1M",
        "item": {
          "type": "and",
          "items": [
            { "type": "survey", "surveyName": "survey1" },
            { "type": "date", "date": "2026-06-01" }
          ]
        }
      },
      "expected": "2026-07-10T08:00:00.000Z"
    },
    {
      "name": "unknown condition type",
      "condition": { "type": "weather" },
      "expected": null
    }
  ]
