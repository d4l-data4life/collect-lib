      "condition": { "type": "response", "responseName": "resp1" },
      "expected": "2026-06-07T07:30:00.000Z"
    },
    {
      "name": "and picks the latest date by default",
      "condition": {
        "type": "and",
        "items": [
          { "type": "survey", "surveyName": "survey1" },
          { "type": "survey", "surveyName": "survey2" }
        ]
      },
      "expected": "2026-06-15T09:00:00.000Z"
    },
    {
      "name": "and with sorting earliest",
      "condition": {
        "type": "and",
        "sorting": "earliest",
        "items": [
          { "type": "survey", "surveyName": "survey1" },
          { "type": "survey", "surveyName": "survey2" }
        ]
      },
      "expected": "2026-06-10T08:00:00.000Z"
    },
    {
      "name": "and with one unfulfilled item",
      "condition": {
        "type": "and",
        "items": [
          { "type": "survey", "surveyName": "survey1" },
          { "type": "consent", "consentKey": "c3" }
        ]
      },
      "expected": null
    },
    {
      "name": "or picks the earliest date by default",
      "condition": {
        "type": "or",
        "items": [
          { "type": "routine", "routineName": "r1" },
          { "type": "consent", "consentKey": "c1" }
        ]
      },
      "expected": "2026-06-01T12:00:00.000Z"
    },
    {
      "name": "or with sorting latest, skipping unfulfilled items",
      "condition": {
        "type": "or",
        "sorting": "latest",
        "items": [
          { "type": "routine", "routineName": "r1" },
          { "type": "consent", "consentKey": "c1" },
          { "type": "survey", "surveyName": "survey3" }
        ]
      },
      "expected": "2026-06-05T06:00:00.000Z"
    },
    {
      "name": "or with no fulfilled item",
      "condition": {
        "type": "or",
        "items": [
          { "type": "consent", "consentKey": "c3" },
          { "type": "survey", "surveyName": "survey3" }
        ]
      },
      "expected": null
